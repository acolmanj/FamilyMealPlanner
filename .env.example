# Supabase > Project Settings > API. Both are public (the browser sees them).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The family passcode screen. Server-only: never prefix these with NEXT_PUBLIC_.
# FAMILY_PASSCODE is what people type. FAMILY_EMAIL / FAMILY_PASSWORD are the
# shared Supabase account the server signs in as (its email must be in
# household_members). Set them in Vercel > Settings > Environment Variables.
FAMILY_PASSCODE=
FAMILY_EMAIL=
FAMILY_PASSWORD=

# Only for `npm run seed` on your own machine. Never commit these.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# HOUSEHOLD_EMAILS=you@example.com,partner@example.com
