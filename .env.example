# Supabase > Project Settings > API. Both are public (the browser sees them).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The family passcode screen. Server-only: never prefix these with NEXT_PUBLIC_.
# FAMILY_PASSCODE is what people type. FAMILY_EMAIL / FAMILY_PASSWORD are the
# shared Supabase account the server signs in as (its email must be in
# household_members). Set them in Vercel > Settings > Environment Variables.
FAMILY_PASSCODE=
FAMILY_EMAIL=
FAMILY_PASSWORD=

# Only for `npm run seed` on your own machine. Never commit these.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# HOUSEHOLD_EMAILS=you@example.com,partner@example.com

# Optional: copy the family's "Weekly Menu" Google Sheet into the plan every 15 minutes
# (.github/workflows/sheet-sync.yml calls /api/sheet-sync). Leave these empty to turn it off.
# GOOGLE_SERVICE_ACCOUNT_JSON is the whole key file of a Google service account that the
# sheet is shared with (view only). SHEET_SYNC_SECRET must match the GitHub repo secret of
# the same name. SHEET_SYNC_FILE_ID defaults to the family's "Weekly Menu" Google Sheet
# (1ID3hf0eSLux3TiLlOUTdVNREMbuQWfdTP3yBYXGEWvU); only its "Menu" tab is read.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_SYNC_SECRET=
SHEET_SYNC_FILE_ID=
